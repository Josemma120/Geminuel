# ============================================================
# Configuración de Claves de IA para Geminuel
# ============================================================

# 1. Groq Cloud — 100% GRATIS (Ejecuta Llama 3.3 70B súper rápido)
# Consíguela gratis en: https://console.groq.com/keys
GROQ_API_KEY=pon_aqui_tu_clave_groq_gsk
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (Gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=pon_aqui_tu_clave_gemini
# GEMINI_MODEL=gemini-3.6-flash

# 3. Opcional: Puerto del servidor local (por defecto 8000)
# PORT=8000